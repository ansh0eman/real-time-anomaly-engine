# Environment variables — DO NOT commit this file to git
# Copy this to .env and fill in your values

# PostgreSQL
POSTGRES_USER=engine_user
POSTGRES_PASSWORD=engine_password
POSTGRES_DB=outlier_db
POSTGRES_URL=postgresql://engine_user:engine_password@postgres:5432/outlier_db

# Redis
REDIS_URL=redis://redis:6379/0

# Internal service authentication
# Used by the worker to authenticate calls to /api/internal/* endpoints
INTERNAL_SECRET=change-me-in-production-use-a-long-random-string

# Worker → API URL
API_URL=http://web_api:8000
